DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Control plane (catálogo de tenants). Se crea automáticamente si no existe.
CONTROL_DB_NAME=ludo_control
# Sincroniza la tabla tenants del control (recomendado: true)
CONTROL_DB_SYNC=true

# En producción: false. Las migraciones tenant se aplican al provisionar / migrate:tenants
DB_SYNC=false
DB_LOGGING=false

JWT_SECRET=change-me-ludo-jwt-secret
JWT_EXPIRES_IN=8h
PORT=3005
CORS_ORIGIN=*
APP_TZ=America/Lima

# Administrador total (consola /platform) — se crea al arrancar si no existe
PLATFORM_ADMIN_USERNAME=platform
PLATFORM_ADMIN_PASSWORD=platform-admin
# PLATFORM_ADMIN_EMAIL=admin@example.com

# Redis (Socket.IO adapter + cache)
REDIS_URL=redis://localhost:6379

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
