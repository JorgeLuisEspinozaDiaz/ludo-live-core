DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Control plane (catálogo de tenants). Se crea automáticamente si no existe.
CONTROL_DB_NAME=wost_control
# Opcional: sobrescribir host/credenciales del control
# CONTROL_DB_HOST=localhost
# CONTROL_DB_PORT=5432
# CONTROL_DB_USER=postgres
# CONTROL_DB_PASSWORD=postgres

# Credenciales usadas al crear BDs por tenant (wost_t_<slug>)
DB_SYNC=true
DB_LOGGING=false

JWT_SECRET=change-me-wost-jwt-secret
JWT_EXPIRES_IN=8h
PORT=3005
CORS_ORIGIN=*
APP_TZ=America/Lima
